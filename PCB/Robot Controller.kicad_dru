(version 1)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.15mm))
)
(rule "Copper to hole clearance 1"
	(constraint hole_clearance (min 0.35mm))
)
(rule "Minimum annular width 1"
	(constraint annular_width (min 0.15mm))
)
(rule "Via style 1"
	(constraint via_diameter (min 0.6mm) (max 100mm))
	(constraint hole_size (min 0.001mm) (max 100mm))
)
